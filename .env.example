# ===== データ生成バッチ (builder) 用の設定 =====
# Web 配信側 (Cloudflare Pages) の Basic 認証情報はここではなく
# Cloudflare Pages のプロジェクト環境変数 (APP_USERNAME / APP_PASSWORD) に設定します。

# --- スクレイピング ---
SCRAPING_ENABLED=true
REQUEST_DELAY_SECONDS=2.5
# 自分の連絡先を含む識別可能な User-Agent を推奨
USER_AGENT=keiba-simulator/2.0 (personal research use; contact: you@example.com)
RESPECT_ROBOTS_TXT=true

# --- 動作モード ---
# true でネットワークなしの合成データ
DEMO_MODE=false

# --- シミュレーション ---
N_SIMS=10000
HISTORY_LIMIT=12

# --- 出力 ---
OUT_DIR=./public
CACHE_DIR=./.cache
# MAX_RACES=6   # 試験時にレース数を制限
